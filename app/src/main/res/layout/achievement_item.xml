<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/achievement_bg"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/achievementIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_trophy_locked" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/achievementTitle"
            android:textColor="#FFF8D6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/achievementDesc"
            android:textColor="#BEBEBE"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/achievementStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Locked"
        android:textStyle="bold"
        android:textColor="#FF8A80"/>
</LinearLayout>
